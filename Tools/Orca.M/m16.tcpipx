     jsl $E10000
 MEND 
 MACRO
&lab ~TCPIPSetDebugHex &p1
&lab ph2 &p1
     ldx #$3B36
     jsl $E10000
 MEND 
 MACRO
&lab ~TCPIPGetDebugTCP
&lab ldx #$3C36
     jsl $E10000
 MEND 
 MACRO
&lab ~TCPIPSetDebugTCP &p1
&lab ph2 &p1
     ldx #$3D36
     jsl $E10000
 MEND 
 MACRO
&lab ~TCPIPGetUserRecord
&lab ldx #$3E36
     jsl $E10000
 MEND 
 MACRO
&lab ~TCPIPReloadModuleList
&lab ldx #$4D36
     jsl $E10000
 MEND